            self.timeout_tasks[user_id].cancel()

        self.timeout_tasks[user_id] = asyncio.create_task(self.timeout_handler(user_id, event))
        
        await event.send(event.plain_result(f"请在 {self.update_timeout} 秒内发送你修改好的【记忆日志】json文件。"))
                   
